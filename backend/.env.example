# =============================================================================
# ComplianceOS backend — .env.example
# Copia in .env e compila con i valori reali (NON committare .env)
# =============================================================================

# --- Azure OpenAI — provider standard (GPT-4.1-mini, v1 OpenAI-compatible) ---
# La URL deve terminare con /openai/v1 e SENZA /chat/completions. Funzionano
# sia il formato Foundry (services.ai.azure.com) sia openai.azure.com.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/openai/v1
AZURE_OPENAI_DEPLOYMENT_GPT_41_MINI=gpt-4.1-mini

# --- Profilo "deep" opzionale (GPT-4.1 full, Data Zone Standard EU) ---
# Instrada le fasi di giudizio (Stage B deep verification, cross-clause,
# executive summary, chat) sul modello forte. Se non settato, tutto resta
# sulla mini. Endpoint/chiave per-modello solo se la risorsa è diversa.
COMPLIANCE_DEEP_PROVIDER=gpt-4.1-azure
AZURE_OPENAI_DEPLOYMENT_GPT_41=gpt-4.1
# AZURE_OPENAI_ENDPOINT_GPT_41=
# AZURE_OPENAI_API_KEY_GPT_41=

# --- Tuning concorrenza (default tarati su quote alte France Central:
#     mini 16M TPM, gpt-4.1 3M TPM — abbassare per quote piccole) ---
# EVIDENCE_MAX_WORKERS=14
# GAP_MAX_WORKERS=6
# DEEP_MAX_WORKERS=6
# CROSS_MAX_WORKERS=9
# RISK_MAX_WORKERS=4

# --- Azure Document Intelligence (OCR per PDF scansionati, prebuilt-read) ---
# Usato da compliance/azure_ocr.py: OCR full-document per PDF interamente
# scansionati e OCR per-pagina sui PDF misti nativi+scansionati (Sprint R1).
AZURE_DI_ENDPOINT=https://<resource>.cognitiveservices.azure.com/
AZURE_DI_KEY=


# --- Sicurezza (Fase 3 consolidamento) ---
# Origins ammessi dal CORS (separati da virgola). Aggiungere qui l'origin del
# tunnel cloudflared/ngrok quando si fa una demo esterna.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
# Password iniziale dell'utente admin al PRIMO avvio (se users.json non esiste).
# Senza questa, viene generata una password casuale stampata una sola volta.
COMPLIANCE_ADMIN_PASSWORD=
